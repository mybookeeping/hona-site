---
import Base from "../layouts/Base.astro";
import Compass from "../components/Compass.astro";
---
<Base title="Subscription confirmed — Hona" noindex={true}>
  <section class="band-cream on-cream slip">
    <div class="shell slip__in">
      <div class="mark"><Compass state="st-approved" plain={true} /></div>
      <h1 style="font-size:clamp(1.9rem,1.4rem+2vw,2.8rem)">You&rsquo;re subscribed</h1>
      <p style="margin-top:1.25rem">Your Hona account is active. Open the app to pick up where you left off.</p>
      <a class="btn btn--ink" href="honamvp://" style="margin-top:1.75rem">Open Hona</a>
      <p class="fine">If the app doesn&rsquo;t open automatically, launch Hona from your home screen.</p>
    </div>
  </section>
</Base>
