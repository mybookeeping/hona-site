---
import Base from "../layouts/Base.astro";
import Compass from "../components/Compass.astro";
import OpenHona from "../components/OpenHona.astro";
---

<Base title="Reset your password — Hona" noindex={true}>
  <section class="band-cream on-cream slip">
    <div class="shell slip__in">
      <div class="mark"><Compass state="st-approved" plain={true} /></div>

      <div id="loading">
        <h1 style="font-size:clamp(1.8rem,1.4rem+1.8vw,2.6rem)">Checking your link</h1>
        <p style="margin-top:1rem">One moment.</p>
      </div>

      <div id="form" hidden>
        <h1 style="font-size:clamp(1.8rem,1.4rem+1.8vw,2.6rem)">Choose a new password</h1>
        <div id="formMsg"></div>
        <div class="pwfield">
          <label for="pw1">New password</label>
          <input id="pw1" type="password" autocomplete="new-password" minlength="8" />
        </div>
        <div class="pwfield">
          <label for="pw2">Confirm password</label>
          <input id="pw2" type="password" autocomplete="new-password" minlength="8" />
        </div>
        <button id="submit" class="btn btn--ink" style="width:100%;justify-content:center;margin-top:.5rem">
          Set new password
        </button>
        <p class="fineprint">At least 8 characters.</p>
      </div>

      <div id="done" hidden>
        <h1 style="font-size:clamp(1.8rem,1.4rem+1.8vw,2.6rem)">Password updated</h1>
        <p style="margin-top:1rem">Open Hona and sign in with your new password.</p>
        <OpenHona deepLink="honamvp://sign-in" variant="btn--ink" style="margin-top:1.75rem" />
      </div>

      <div id="failed" hidden>
        <h1 style="font-size:clamp(1.8rem,1.4rem+1.8vw,2.6rem)">This link didn't work</h1>
        <div id="failMsg"></div>
        <p class="fineprint" style="margin-top:1.5rem">
          Open Hona, tap <strong>Forgot Password</strong> and request a new
          link. Reset links expire and can only be used once.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .pwfield { text-align: left; margin: 1.5rem auto 0; max-width: 26rem; }
  .pwfield label {
    display: block; font-family: var(--display); font-size: .78rem; font-weight: 700;
    font-stretch: 112%; letter-spacing: .14em; text-transform: uppercase;
    color: var(--walnut); margin-bottom: .5rem;
  }
  .pwfield input {
    width: 100%; padding: .85rem 1rem; font-size: 1rem; font-family: var(--body);
    border: 1px solid rgba(20,22,26,.22); border-radius: 2px; background: #fff; color: var(--ink);
  }
  #form { max-width: 26rem; margin-inline: auto; }
  .fineprint { font-size: .85rem; color: var(--walnut); margin-top: 1rem; }
  .msg { padding: .85rem 1rem; border-radius: 2px; font-size: .95rem; margin-top: 1.5rem; text-align: left; }
  .msg--bad { background: #F7EBEE; color: var(--maroon); border: 1px solid #E6CDD4; }
</style>

<script>
  import { supabase as sb } from "../lib/supabase";

  (function () {
    var el = function (id) { return document.getElementById(id); };
    var show = function (id) { el(id).hidden = false; };
    var hide = function (id) { el(id).hidden = true; };

    function fail(m) {
      hide("loading"); hide("form");
      el("failMsg").innerHTML = '<p class="msg msg--bad">' + m + "</p>";
      show("failed");
    }

    var q = new URLSearchParams(location.search);
    var h = new URLSearchParams(location.hash.replace(/^#/, ""));
    var tokenHash = q.get("token_hash") || q.get("token");
    var type = q.get("type");
    var code = q.get("code");
    var at = h.get("access_token");
    var rt = h.get("refresh_token");
    var errDesc = q.get("error_description") || h.get("error_description");

    function begin() {
      if (errDesc) return Promise.reject(new Error(decodeURIComponent(errDesc.replace(/\+/g, " "))));
      if (at && rt) return sb.auth.setSession({ access_token: at, refresh_token: rt });
      if (tokenHash) return sb.auth.verifyOtp({ token_hash: tokenHash, type: type || "recovery" });
      if (code) return sb.auth.exchangeCodeForSession(code);
      return Promise.reject(new Error("No reset token was found in this link."));
    }

    begin()
      .then(function (r) {
        if (r && r.error) throw r.error;
        hide("loading"); show("form"); el("pw1").focus();
      })
      .catch(function (e) {
        var m = (e && e.message) || "Something went wrong.";
        if (/expired|invalid|not found/i.test(m)) m = "This reset link has expired or has already been used.";
        fail(m);
      });

    el("submit").addEventListener("click", function () {
      var a = el("pw1").value, b = el("pw2").value;
      el("formMsg").innerHTML = "";
      function bad(m) { el("formMsg").innerHTML = '<p class="msg msg--bad">' + m + "</p>"; }
      if (a.length < 8) return bad("Password must be at least 8 characters.");
      if (a !== b) return bad("Passwords don't match.");

      el("submit").disabled = true;
      el("submit").textContent = "Saving";
      sb.auth.updateUser({ password: a })
        .then(function (r) { if (r.error) throw r.error; hide("form"); show("done"); })
        .catch(function (e) {
          bad((e && e.message) || "Could not update the password. Request a new link.");
          el("submit").disabled = false;
          el("submit").textContent = "Set new password";
        });
    });

    ["pw1", "pw2"].forEach(function (id) {
      el(id).addEventListener("keydown", function (ev) { if (ev.key === "Enter") el("submit").click(); });
    });
  })();
</script>
