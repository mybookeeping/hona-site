---
import Base from "../layouts/Base.astro";
import Start from "../components/Start.astro";

// Conference defaults — change these two between conferences, then
// rebuild and redeploy. The printed QR code just encodes a bare
// https://honafinancial.com/meet and never changes.
const DEFAULT_SRC = "bpcon";
const DEFAULT_GRANT = "HONA26";
---

<Base
  title="We just met — Hona"
  description="Hona tells a contractor what a job is costing while there's still time to do something about it. Free for lenders, always."
  noindex={true}
  ogTitle="Hona — the Fix & Flip Workbook"
  ogDescription="Work breakdown, schedule and Gantt, draw schedule, deal underwriting, and the cash you carry between draws. Free."
  ogImage="https://honafinancial.com/og-meet.png"
  ogUrl="https://honafinancial.com/meet"
>

  <section class="band-ink">
    <div class="shell">
      <p class="eyebrow eyebrow--brass">We just met.</p>
      <h1>Hona is a financial operating system for project-based builds.</h1>
      <p>
        It tells you what a job is costing while there's still time to do
        something about it.
      </p>
      <div class="audience-pair">
        <p><strong>Investors</strong> — a plug-and-play rehab structure if
        you don't have a construction background.</p>
        <p><strong>Contractors</strong> — every receipt lands in a phase,
        and your lender sees the draw without a phone call.</p>
      </div>
    </div>
  </section>

  <section class="band-billiard">
    <div class="shell">
      <p class="eyebrow eyebrow--pale">For lenders</p>
      <p class="lede">
        Your borrower's budget stops being a mystery between draws. They
        submit complete packets because the data was captured as it was
        spent, not reconstructed the night before.
      </p>
      <p class="emphasis">Free for lenders. Always.</p>
    </div>
  </section>

  <section class="band-cream signup-section">
    <div class="shell">
      <div id="meetConfig" data-default-src={DEFAULT_SRC} hidden></div>

      <div class="offer grant-offer" id="offerConference">
        <p class="eyebrow" style="margin-bottom:.75rem">Conference offer</p>
        <p class="grant-code" id="grantCode">{DEFAULT_GRANT}</p>
        <p>30 days free when you sign up with this code.</p>
        <p class="offer-addon">
          Plus the Fix &amp; Flip Workbook — free, and it downloads the
          moment you submit.
        </p>
      </div>

      <div class="offer workbook-offer" id="offerWorkbook" hidden>
        <p class="eyebrow" style="margin-bottom:.75rem">Free — the Fix &amp; Flip Workbook</p>
        <p>
          Answer fourteen questions about the house, the money and your
          terms. Untick the work this house doesn't need. Type in what your
          subs quoted. It builds your budget, your schedule, your draw
          schedule, the cash you carry between draws, and the most you
          should pay for the house.
        </p>
        <p>Enter your details and it downloads on the next screen.</p>
      </div>

      <form id="signupForm" novalidate>
        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <fieldset class="role-group">
          <legend>I'm a</legend>
          <div class="role-options">
            <label class="role-option">
              <input type="radio" name="role" value="contractor" required />
              <span>Contractor</span>
            </label>
            <label class="role-option">
              <input type="radio" name="role" value="lender" />
              <span>Lender</span>
            </label>
            <label class="role-option">
              <input type="radio" name="role" value="other" />
              <span>Other</span>
            </label>
          </div>
        </fieldset>

        <div class="hp" aria-hidden="true">
          <label for="website">Leave this field blank</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div id="signupMsg"></div>

        <button id="signupSubmit" type="submit" class="btn btn--brass" style="width:100%;justify-content:center">
          Claim my 30 days
        </button>

        <p class="founders-note" id="foundersNote">
          Founders pricing is limited to the first 50 subscribers, held for
          as long as the subscription remains active and continuous; if it
          lapses the rate is released and cannot be reclaimed.
        </p>
        <p class="founders-note" id="workbookNote" hidden>
          You'll also get 30 days free when Hona launches.
        </p>
      </form>

      <div id="signupDone" hidden>
        <p class="lede" id="doneLede">You're in.</p>
        <p>Best opened on a desktop — it's a working model with live formulas, not a PDF.</p>
        <div id="downloadLinks"></div>
        <p class="workbook-email-note" id="workbookEmailNote" hidden>A copy has also been sent to your email.</p>
      </div>
    </div>
  </section>

  <section class="band-cream cta-section">
    <div class="shell">
      <Start />
      <p class="signature">
        Jared Watson · Founder<br />
        <a href="mailto:jared@honafinancial.com">jared@honafinancial.com</a>
      </p>
      <p class="lede closing">
        I'd rather hear about your last job than send you a brochure.
        <a href="mailto:jared@honafinancial.com?subject=We%20just%20met">Email me.</a>
      </p>
    </div>
  </section>

</Base>

<style>
  .cta-section .shell { text-align: center; }

  .emphasis {
    font-family: var(--display);
    font-weight: 700;
    font-stretch: 108%;
    font-size: 1.15rem;
    color: var(--brass-l);
  }

  .signature {
    margin-top: 2rem;
    font-family: var(--display);
    font-size: .85rem;
    letter-spacing: .02em;
    color: var(--walnut-tx);
  }
  .signature a { color: inherit; }

  .closing { margin: 1.75rem auto 0; }
  .closing a {
    color: var(--brass);
    border-bottom: 1px solid var(--brass);
  }

  .audience-pair { margin-top: 1.5rem; }
  .audience-pair p { margin: 0 0 .75rem; }
  .audience-pair p:last-child { margin-bottom: 0; }

  .signup-section .shell { max-width: 30rem; }

  .grant-offer, .workbook-offer { text-align: left; }
  .offer-addon { font-size: .85rem; color: var(--walnut-tx); margin: .75rem 0 0; }
  .grant-code {
    font-family: var(--display);
    font-weight: 800;
    font-stretch: 120%;
    font-size: 1.9rem;
    letter-spacing: .04em;
    color: var(--brass-l);
    margin: 0 0 .6rem;
  }

  #signupForm { text-align: left; margin-top: 2rem; }

  .field { margin-bottom: 1.25rem; }
  .field label {
    display: block;
    font-family: var(--display);
    font-size: .78rem;
    font-weight: 700;
    font-stretch: 112%;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--walnut);
    margin-bottom: .5rem;
  }
  .field input {
    width: 100%;
    padding: .85rem 1rem;
    font-size: 1rem;
    font-family: var(--body);
    border: 1px solid rgba(20,22,26,.22);
    border-radius: 2px;
    background: #fff;
    color: var(--ink);
  }

  .role-group { border: 0; padding: 0; margin: 0 0 1.5rem; }
  .role-group legend {
    font-family: var(--display);
    font-size: .78rem;
    font-weight: 700;
    font-stretch: 112%;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--walnut);
    margin-bottom: .6rem;
    padding: 0;
  }
  .role-options { display: flex; flex-wrap: wrap; gap: .6rem; }
  .role-option { position: relative; }
  .role-option input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .role-option span {
    display: inline-block;
    padding: .55rem 1.05rem;
    border: 1px solid rgba(20,22,26,.28);
    border-radius: 2px;
    font-family: var(--display);
    font-size: .85rem;
    font-weight: 600;
    color: var(--ink);
    transition: background .15s, border-color .15s, color .15s;
  }
  .role-option input:checked + span {
    background: var(--brass);
    border-color: var(--brass);
  }
  .role-option input:focus-visible + span {
    outline: 2px solid var(--brass);
    outline-offset: 2px;
  }

  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .founders-note { font-size: .85rem; color: var(--walnut-tx); margin-top: 1.5rem; }

  .signup-msg { padding: .85rem 1rem; border-radius: 2px; font-size: .95rem; margin-top: 1.25rem; text-align: left; }
  .signup-msg--bad {
    background: color-mix(in srgb, var(--maroon) 10%, white);
    color: var(--maroon);
    border: 1px solid color-mix(in srgb, var(--maroon) 30%, white);
  }

  #signupDone { text-align: left; margin-top: 2rem; }
  .workbook-email-note { font-size: .85rem; color: var(--walnut-tx); margin: .75rem 0 0; }
</style>

<script>
  import { supabase } from "../lib/supabase";

  (function () {
    // Ship Part 1 now; Part 2 is a deliberate follow-up email to the
    // list. Adding it later is just another entry in this array.
    var WORKBOOKS = [
      { slug: "part1", filename: "Hona_Fix_and_Flip_Workbook.xlsx", label: "Download the workbook" },
    ];

    var params = new URLSearchParams(location.search);
    var mode = params.get("offer") === "workbook" ? "workbook" : "conference";

    var defaultSrc = document.getElementById("meetConfig").dataset.defaultSrc;
    var rawSrc = (params.get("src") || "").trim().toLowerCase().slice(0, 40);
    var source = rawSrc || defaultSrc;

    var codeEl = document.getElementById("grantCode");
    var raw = (params.get("c") || "").toUpperCase();
    if (/^[A-Z0-9]{4,12}$/.test(raw)) codeEl.textContent = raw;
    var grantCode = codeEl.textContent;

    var form = document.getElementById("signupForm");
    var submitBtn = document.getElementById("signupSubmit");
    var msgEl = document.getElementById("signupMsg");
    var doneEl = document.getElementById("signupDone");
    var doneLedeEl = document.getElementById("doneLede");
    var downloadLinksEl = document.getElementById("downloadLinks");
    var workbookEmailNoteEl = document.getElementById("workbookEmailNote");

    var submitLabel = "Claim my 30 days";
    var doneLede = "You're in. Here's the workbook while you wait.";

    if (mode === "workbook") {
      document.getElementById("offerConference").hidden = true;
      document.getElementById("offerWorkbook").hidden = false;
      document.getElementById("foundersNote").hidden = true;
      document.getElementById("workbookNote").hidden = false;
      submitLabel = "Send me the workbook";
      doneLede = "Here it is.";
    }
    submitBtn.textContent = submitLabel;

    function showMsg(text) {
      msgEl.innerHTML = '<p class="signup-msg signup-msg--bad">' + text + "</p>";
    }

    function renderDownloadLinks(signupId) {
      downloadLinksEl.innerHTML = WORKBOOKS.map(function (w) {
        return (
          '<p><a class="btn btn--ink" href="/downloads/' + w.filename +
          '" download="' + w.filename + '" data-workbook="' + w.slug + '">' +
          w.label + "</a></p>"
        );
      }).join("");

      downloadLinksEl.querySelectorAll("a[data-workbook]").forEach(function (a) {
        a.addEventListener("click", function () {
          // Fire-and-forget: never block or fail the download over this.
          supabase
            .from("meet_downloads")
            .insert({
              id: crypto.randomUUID(),
              signup_id: signupId,
              workbook: a.getAttribute("data-workbook"),
            })
            .then(function () {})
            .catch(function () {});
        });
      });
    }

    form.addEventListener("submit", function (ev) {
      ev.preventDefault();
      msgEl.innerHTML = "";

      var website = form.elements.website.value;
      var name = form.elements.name.value.trim();
      var email = form.elements.email.value.trim();
      var roleInput = form.querySelector('input[name="role"]:checked');

      if (website) {
        // Honeypot tripped — behave as if it worked, write nothing.
        form.hidden = true;
        doneLedeEl.textContent = doneLede;
        doneEl.hidden = false;
        return;
      }

      if (!name) return showMsg("Enter your name.");
      if (!email) return showMsg("Enter your email.");
      if (!roleInput) return showMsg("Choose contractor, lender, or other.");

      submitBtn.disabled = true;
      submitBtn.textContent = "Sending";

      var signupId = crypto.randomUUID();

      var timeoutId;
      var timeout = new Promise(function (_, reject) {
        timeoutId = setTimeout(function () {
          reject(new Error("timeout"));
        }, 15000);
      });

      Promise.race([
        supabase.from("meet_signups").insert({
          id: signupId,
          name: name,
          email: email,
          role: roleInput.value,
          grant_code: grantCode,
          source: source,
        }),
        timeout,
      ])
        .then(function (r) {
          clearTimeout(timeoutId);
          if (r.error) throw r.error;
          form.hidden = true;
          doneLedeEl.textContent = doneLede;
          doneEl.hidden = false;
          renderDownloadLinks(signupId);

          // Best-effort only: the download already happened, so a failure
          // here must never surface an error or touch the signup UI.
          var emailTimeoutId;
          var emailTimeout = new Promise(function (_, reject) {
            emailTimeoutId = setTimeout(function () {
              reject(new Error("timeout"));
            }, 10000);
          });

          Promise.race([
            supabase.functions.invoke("send-workbook", {
              body: { signup_id: signupId },
            }),
            emailTimeout,
          ])
            .then(function (r) {
              clearTimeout(emailTimeoutId);
              if (r.error) throw r.error;
              if (r.data && r.data.sent) {
                workbookEmailNoteEl.hidden = false;
              }
            })
            .catch(function () {
              clearTimeout(emailTimeoutId);
            });
        })
        .catch(function () {
          clearTimeout(timeoutId);
          showMsg("Something went wrong. Try again, or email jared@honafinancial.com directly.");
          submitBtn.disabled = false;
          submitBtn.textContent = submitLabel;
        });
    });
  })();
</script>
