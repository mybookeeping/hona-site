---
import Base from "../../layouts/Base.astro";
import Compass from "../../components/Compass.astro";
import OpenHona from "../../components/OpenHona.astro";
import { APP_STORE_URL } from "../../config/checkout";
---
<Base title="Checkout cancelled — Hona" noindex={true}>
  <section class="band-cream on-cream slip">
    <div class="shell slip__in">
      <div class="mark"><Compass state="st-none" plain={true} /></div>
      <h1 style="font-size:clamp(1.9rem,1.4rem+2vw,2.8rem)">Checkout cancelled</h1>
      <p style="margin-top:1.25rem">No charge was made. You can return to Hona and subscribe whenever you&rsquo;re ready.</p>

      <div class="offer">
        <p class="eyebrow" style="margin-bottom:.75rem">Keep your records</p>
        <p style="margin:0 0 1.25rem">
          Your projects, receipts and draw history stay exactly where they are.
          You can manage or change your plan anytime from inside the app.
        </p>
        <a class="btn btn--ink" href={APP_STORE_URL}>Download on the App Store</a>
      </div>

      <OpenHona
        variant="btn--ghost"
        style="margin-top:1.5rem"
        linkStyle="border-color:rgba(20,22,26,.3)"
      />
    </div>
  </section>
</Base>
