---
import { APP_STORE_URL } from "../config/checkout";

interface Props { variant?: string; label?: string; class?: string; }
const { variant = "btn--brass", label, class: klass = "" } = Astro.props;
const text = label ?? "Download on the App Store";
---

<a class={`btn ${variant} ${klass}`} href={APP_STORE_URL}>{text}</a>
